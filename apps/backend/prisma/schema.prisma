// ============================================================
// SnapTrace Platform - Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum RecordingType {
  SCREEN
  TAB
  WEBCAM
  SCREENSHOT
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
}

model Recording {
  id            String          @id @default(cuid())
  title         String          @default("Untitled Recording")
  description   String?
  userId        String
  teamId        String?
  status        RecordingStatus @default(UPLOADING)
  type          RecordingType   @default(SCREEN)
  url           String?
  thumbnailUrl  String?
  duration      Int? // seconds
  size          BigInt? // bytes
  mimeType      String?
  shareId       String          @unique @default(cuid())
  isPublic      Boolean         @default(false)
  allowDownload Boolean         @default(true)
  viewCount     Int             @default(0)
  metadata      Json?
  consoleLogs   Json?
  networkLogs   Json?
  chunks        UploadChunk[]
  shareLinks    ShareLink[]
  comments      Comment[]
  analytics     Analytics[]
  reactions     Reaction[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([teamId])
  @@index([shareId])
  @@index([status])
  @@index([createdAt])
}

model UploadChunk {
  id          String    @id @default(cuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  totalChunks Int
  size        Int
  checksum    String?
  cloudUrl    String?
  uploadedAt  DateTime  @default(now())

  @@unique([recordingId, chunkIndex])
  @@index([recordingId])
}

model ShareLink {
  id                  String    @id @default(cuid())
  recordingId         String
  recording           Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  token               String    @unique
  password            String?
  expiresAt           DateTime?
  isPasswordProtected Boolean   @default(false)
  allowDownload       Boolean   @default(true)
  viewCount           Int       @default(0)
  createdAt           DateTime  @default(now())

  @@index([recordingId])
  @@index([token])
}

model Comment {
  id          String    @id @default(cuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String?
  guestName   String?
  content     String
  timestamp   Float?
  parentId    String?
  parent      Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies     Comment[] @relation("Replies")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([recordingId])
  @@index([userId])
  @@index([parentId])
}

model Reaction {
  id          String    @id @default(cuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String?
  visitorId   String?
  emoji       String
  createdAt   DateTime  @default(now())

  @@unique([recordingId, userId, emoji])
  @@unique([recordingId, visitorId, emoji])
  @@index([recordingId])
}

model Analytics {
  id          String    @id @default(cuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  event       String
  visitorId   String?
  ip          String?
  userAgent   String?
  referer     String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([recordingId])
  @@index([event])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  resource  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

# ============================================================
# HOW TO USE BRANCH-SPECIFIC ENV FILES
# ============================================================
# Do NOT edit .env directly for branch-specific work.
# Instead, create a .env.<branch>.local file and run with:
#
#   npm run dev:portal   → loads .env.portal.local   (portalDB branch)
#   npm run dev:test     → loads .env.test.local
#   npm run dev:patient  → loads .env.patient.local
#   npm run dev:doctor   → loads .env.doctor.local
#
# All .env.*.local files are gitignored — safe to store real secrets.
# Copy this file to .env.<branch>.local and fill in real values.
#
# cp .env.example .env.portal.local
# ============================================================

# ============================================================
# Server Configuration
# ============================================================
PORT=4000
NODE_ENV=development

# ============================================================
# Database
# ============================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/jam_platform?schema=public"

# ============================================================
# Redis
# ============================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ============================================================
# JWT Authentication
# ============================================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="10d"

# ============================================================
# External Storage + Portal API (ReportPortal-style)
# ============================================================
# Base URL of the external portal system
EXTERNAL_API_BASE_URL="http://localhost:3000"

# Bearer JWT — auto-refreshed via password grant below (leave empty to force refresh on start)
EXTERNAL_API_TOKEN=""

# OAuth2 password grant credentials for auto-refreshing the token
EXTERNAL_API_USERNAME="superadmin"
EXTERNAL_API_PASSWORD="your-portal-password"

# Project ID in the portal (leave empty to use default)
EXTERNAL_PROJECT_ID=""

# ============================================================
# Cloudinary Storage (legacy — not required when using external API)
# ============================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================
# CORS & Security
# ============================================================
CORS_ORIGIN="http://localhost:3001,chrome-extension://your-extension-id"
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ============================================================
# Auth Configuration
# ============================================================
BCRYPT_ROUNDS=12

# ============================================================
# Upload Configuration
# ============================================================
UPLOAD_MAX_SIZE=5368709120
CHUNK_SIZE=5242880

# ============================================================
# Frontend URL (used in password reset emails + OAuth redirects)
# ============================================================
FRONTEND_URL="http://localhost:3001"

# ============================================================
# Worker
# ============================================================
WORKER_SECRET="your-worker-secret-key-change-in-production"

# ============================================================
# Google OAuth 2.0
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ============================================================
# Email (SMTP for password reset emails)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@snaptrace.app

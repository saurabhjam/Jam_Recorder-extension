# ============================================================
# HOW TO USE BRANCH-SPECIFIC ENV FILES
# ============================================================
# Run with:  npm run dev:portal / dev:test / dev:patient / dev:doctor
# Vite loads .env.<mode>.local automatically — no extra tooling needed.
#
# cp .env.example .env.portal.local
# ============================================================

VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME=SnapTrace
VITE_APP_VERSION=1.0.0
